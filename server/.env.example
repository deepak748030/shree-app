# ── Runtime ──────────────────────────────────────────────────────────────
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# ── Required ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/shree-jii
JWT_SECRET=replace-with-a-long-random-secret

# ── Cloudinary: avatars, banners, quotes, presets, donation scanner ──────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Razorpay: membership checkout + payment verification ─────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# ── Optional shared cache (Upstash Redis REST) ───────────────────────────
# Leave blank to run with the in-process cache only. Everything still works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Performance tuning (defaults shown) ──────────────────────────────────
# CACHE_MAX_ENTRIES=1000
# CACHE_TTL_SECONDS=30
# ANALYTICS_TTL_SECONDS=15
# CACHE_VERSION_REFRESH_MS=2000

# ── Realtime (Server-Sent Events) ────────────────────────────────────────
# REALTIME_THROTTLE_MS=1500
# REALTIME_HEARTBEAT_MS=25000
# REALTIME_LOG_SIZE=250
# REALTIME_MAX_CLIENTS=5000

# ── Database resilience ──────────────────────────────────────────────────
# DB_TIMEOUT_MS=5000
# DB_RETRY_COOLDOWN_MS=3000
# DB_MAX_POOL=10

# ── Data retention (logs are archived before trimming) ───────────────────
# DAILY_LOG_RETAIN_DAYS=400
# HANDWRITTEN_RETAIN_DAYS=400

# ── Security / observability ─────────────────────────────────────────────
# CORS_ORIGINS=https://admin.example.com,https://app.example.com
# LOGIN_MAX_ATTEMPTS=10
# SLOW_REQUEST_MS=400
# KEEP_ALIVE_TIMEOUT_MS=65000
