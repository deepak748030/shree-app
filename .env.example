# ── Admin dashboard (Vite) ──────────────────────────────────────────────
# Leave VITE_API_URL empty in development: the dev server proxies /api to the
# Express API (see vite.config.ts), so the browser only talks to its own origin.
# In production set the full URL, including /api:
#   VITE_API_URL=https://your-api.example.com/api
VITE_API_URL=

# Where the Vite dev server proxies /api (development only)
VITE_PROXY_TARGET=http://127.0.0.1:5000

# Client-side request timeout in milliseconds (optional)
VITE_API_TIMEOUT_MS=20000
